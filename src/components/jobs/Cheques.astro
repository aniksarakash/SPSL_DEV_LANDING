---
// Job 2. The working model is the test rig: a synthetic cheque book goes to a
// simulated printer, and the rig compares each sheet with the job.
import Job from '../Job.astro';
import { CELL, HEIGHT, micrPath, serial7 } from '../../lib/e13b';

// On-us, serial, on-us. Transit, routing, transit. Account, on-us. Code.
// Every number is a placeholder. The serial is drawn apart so the model can change it.
const rest = 'C       C A000000000A 0000000000000C 10';
const last = 108;
const sheets = Array.from({ length: 8 }, (_, i) => serial7(101 + i));
---

<Job
  id="cheques"
  statusNote="Nothing has been tested on a real printer. Nothing is deployed to production. The remodelling plan is not written yet."
>
  <div slot="moment" class="moment chq" data-demo="micr">
    <div class="moment__caption small">
      <strong>Working model: the test rig</strong>
      <span>Synthetic job. Simulated printer.</span>
    </div>

    <div class="chq__stage">
      <div class="chq__leaf" data-leaf>
        <p class="chq__no small">Cheque no. <b data-leafno>{serial7(last)}</b></p>
        <div class="chq__body" aria-hidden="true">
          <div class="chq__rules"><i></i><i></i><i></i></div>
          <div class="chq__amount">৳</div>
        </div>
        <div class="chq__line">
        <svg
          class="chq__micr"
          viewBox={`0 0 ${rest.length * CELL} ${HEIGHT}`}
          role="img"
          aria-label={`Magnetic ink character line. Serial ${serial7(last)}.`}
          shape-rendering="crispEdges"
          data-micr
        >
          <path d={micrPath(rest)}></path>
          <path d={micrPath(serial7(last), CELL)} data-serial></path>
        </svg>
        </div>
      </div>
    </div>

    <h3 id="chq-tray">Sheets that the simulated printer received</h3>
    <ol class="chq__tray small" aria-labelledby="chq-tray" data-tray>
      {sheets.map((s) => <li class="chq__chip">{s}</li>)}
    </ol>

    <div class="moment__controls">
      <fieldset class="seg">
        <legend>Put a fault in the job, and see if the rig finds it</legend>
        <label><input type="radio" name="chq-fault" value="none" checked />No fault</label>
        <label><input type="radio" name="chq-fault" value="duplicate" />Duplicate</label>
        <label><input type="radio" name="chq-fault" value="missing" />Missing</label>
        <label><input type="radio" name="chq-fault" value="order" />Out of order</label>
      </fieldset>
      <button class="btn" type="button" data-run>Run the job</button>
    </div>

    <p class="moment__say" role="status" data-say>8 sheets expected. 8 received, in order. Rig report: no differences.</p>
  </div>

  <p class="remark">A wrong cheque is a banking incident. So every change is small, tested, and waits for approval.</p>
  <ul class="facts">
    <li>A Windows desktop program with a SQL Server database. It prints cheque books on production printers.</li>
    <li>The team took the program over. It now builds on a clean machine with one script.</li>
    <li>A test rig runs the program against a simulated printer. It uses synthetic jobs only.</li>
    <li>Each fix is kept on a separate branch, with one recorded run before the fix and one after it.</li>
    <li>The program has been compared with the Bangladesh Bank cheque design specification.</li>
  </ul>
  <p class="stack small"><b>Made with</b> C# WinForms on .NET Framework 4.7.2, and SQL Server.</p>
</Job>

<style is:global>
  .chq__stage {
    padding: clamp(0.75rem, 0.4rem + 1.6vw, 1.5rem);
    border-radius: 0.5rem;
    background-color: var(--paper-shade);
    overflow: hidden;
  }

  .chq__leaf {
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding: clamp(0.7rem, 0.4rem + 1.4vw, 1.25rem);
    border: 1.5px solid var(--blue);
    border-radius: 3px;
    background: #fff;
    box-shadow: 3px 3px 0 rgb(12 82 163 / 0.18);
  }

  /* The word is decoration, so it is drawn by the style sheet and not as text. */
  .chq__leaf::before {
    content: 'Specimen';
    position: absolute;
    right: 6%;
    top: 26%;
    font-size: clamp(1.4rem, 0.8rem + 3.4vw, 3rem);
    font-stretch: 62%;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(240 60 36 / 0.2);
    transform: rotate(-8deg);
    pointer-events: none;
  }

  .chq__no {
    color: var(--blue);
  }

  .chq__no b {
    font-family: var(--mono);
    font-weight: 700;
    color: var(--over);
  }

  .chq__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(4.5rem, 24%, 9rem);
    gap: 1rem;
    align-items: center;
    padding-block: 0.4rem 0.9rem;
  }

  .chq__rules {
    display: grid;
    gap: 0.85rem;
  }

  .chq__amount {
    height: 2.1rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--rule-strong);
    color: var(--blue);
    font-weight: 700;
    line-height: 1.6rem;
  }

  .chq__rules i {
    height: 1px;
    background: var(--rule-strong);
  }

  .chq__rules i:nth-child(1) {
    width: 72%;
  }
  .chq__rules i:nth-child(2) {
    width: 88%;
  }
  .chq__rules i:nth-child(3) {
    width: 40%;
  }

  /* On a narrow leaf the line keeps a readable size and runs off the right
     edge. The serial, which is the part that changes, stays in view. */
  .chq__leaf {
    container-type: inline-size;
  }

  .chq__line {
    overflow: hidden;
  }

  .chq__micr {
    width: 100%;
    min-width: 27rem;
    height: auto;
    fill: var(--over);
  }

  @container (max-width: 29rem) {
    .chq__line {
      mask-image: linear-gradient(90deg, #000 calc(100% - 2.5rem), transparent);
    }
  }

  .chq h3 {
    margin-top: 1rem;
  }

  .chq__tray {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    min-height: 2.1rem;
    margin-top: 0.5rem;
    font-family: var(--mono);
    font-stretch: 100%;
  }

  .chq__chip {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--blue);
    border-radius: 3px;
    color: var(--blue);
    background: #fff;
  }

  .chq__chip.is-bad {
    border: 2px solid var(--red-text);
    color: var(--red-text);
    font-weight: 700;
  }

  .chq .moment__controls {
    align-items: flex-end;
    gap: 1rem;
  }
</style>
