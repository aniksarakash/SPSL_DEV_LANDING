---
// Sheet furniture: crop marks at the four corners of the viewport and, on wide
// screens, the colour bar. The five patches of the colour bar are the page navigation.
import { jobs } from '../data/jobs';
const dots = ['46%', '40%', '33%', '26%', '19%'];
---

<div class="crops" aria-hidden="true">
  <i class="crop crop--tl"></i><i class="crop crop--tr"></i><i class="crop crop--bl"></i><i class="crop crop--br"></i>
</div>

<nav class="bar" aria-label="Jump to a job">
  <ul>
    {
      jobs.map((job, i) => (
        <li>
          <a href={`#${job.id}`} data-patch={job.id} style={`--dot:${dots[i]}`}>
            <span class="bar__patch tint" />
            <span class="bar__label">{job.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .crop {
    position: fixed;
    z-index: 40;
    width: 14px;
    height: 14px;
    pointer-events: none;
    --o: 5px;
  }
  .crop::before,
  .crop::after {
    content: '';
    position: absolute;
    background: var(--blue);
  }
  /* The two strokes of a crop mark stop short of the corner they point at. */
  .crop::before {
    width: 9px;
    height: 1.5px;
  }
  .crop::after {
    width: 1.5px;
    height: 9px;
  }
  .crop--tl {
    top: var(--o);
    left: var(--o);
  }
  .crop--tl::before {
    left: 0;
    bottom: 0;
  }
  .crop--tl::after {
    right: 0;
    top: 0;
  }
  .crop--tr {
    top: var(--o);
    right: var(--o);
  }
  .crop--tr::before {
    right: 0;
    bottom: 0;
  }
  .crop--tr::after {
    left: 0;
    top: 0;
  }
  .crop--bl {
    bottom: var(--o);
    left: var(--o);
  }
  .crop--bl::before {
    left: 0;
    top: 0;
  }
  .crop--bl::after {
    right: 0;
    bottom: 0;
  }
  .crop--br {
    bottom: var(--o);
    right: var(--o);
  }
  .crop--br::before {
    right: 0;
    top: 0;
  }
  .crop--br::after {
    left: 0;
    bottom: 0;
  }
  @media (min-width: 64rem) {
    .crop {
      width: 22px;
      height: 22px;
      --o: 12px;
    }
    .crop::before {
      width: 14px;
    }
    .crop::after {
      height: 14px;
    }
  }

  .bar {
    display: none;
  }
  @media (min-width: 64rem) {
    .bar {
      display: block;
      position: fixed;
      z-index: 30;
      right: 1.1rem;
      top: 50%;
      transform: translateY(-50%);
    }
    .bar ul {
      display: grid;
    }
    .bar a {
      position: relative;
      display: grid;
      place-items: center;
      width: 3rem;
      height: 3rem;
      text-decoration: none;
    }
    .bar__patch {
      width: 2rem;
      height: 2rem;
      border: 1.5px solid var(--blue);
      background-color: #fff;
      --screen: 5px;
      transition:
        transform var(--fast) var(--ease-out),
        box-shadow var(--fast) var(--ease-out);
    }
    .bar a:hover .bar__patch,
    .bar a:focus-visible .bar__patch {
      transform: translate3d(-2px, -2px, 0);
      box-shadow: 4px 4px 0 var(--red);
    }
    .bar a:active .bar__patch {
      transform: none;
      box-shadow: none;
    }
    .bar a[aria-current='true'] .bar__patch {
      background: var(--blue);
      box-shadow: 4px 4px 0 var(--red);
      transform: translate3d(-2px, -2px, 0);
    }
    .bar__label {
      position: absolute;
      right: calc(100% + 0.4rem);
      top: 50%;
      padding: 0.3rem 0.6rem;
      background: var(--over);
      color: var(--paper);
      font-size: var(--step--1);
      font-weight: 600;
      font-stretch: 88%;
      white-space: nowrap;
      border-radius: 0.3rem;
      opacity: 0;
      transform: translate3d(6px, -50%, 0);
      pointer-events: none;
      transition:
        opacity var(--fast) linear,
        transform var(--fast) var(--ease-out);
    }
    .bar a:hover .bar__label,
    .bar a:focus-visible .bar__label {
      opacity: 1;
      transform: translate3d(0, -50%, 0);
    }
  }
</style>
